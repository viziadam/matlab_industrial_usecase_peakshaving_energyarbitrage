function test_single_day_ems()
    % TEST_SINGLE_DAY_EMS - 10 napos bemelegítéssel (warm-up) rendelkező teszt

    clc; close all;
    fprintf('=== 30 NAPOS EMS TESZTKÖRNYEZET ===\n');

    % 1. Adatok betöltése
    fprintf('Adatok betöltése a gyorsítótárból...\n');
    PV_A = build_pv_cache(11, [95, 275], [274, 274], 0.325);
    PV_B = build_pv_cache(11, [70, 250], [100.5, 100.5], 0.325);
    [Load, Price] = build_load_price_cache();

    FINAL_DAY = 210;
    START_DAY = FINAL_DAY - 129;

    % 2. Rendszer paraméterek
    E_bess_cap = 1500; % [kWh]
    P_bess_max = 750;  % [kW]

    pars = base_battery_pars_nonideal_(E_bess_cap, P_bess_max);
    pars.P_inv_limit_ac = 550;              % Inverter limit
    pars.degradation_cost_per_kWh = 5.0;    % [HUF/kWh throughput]

    % Akku inicializálása
    init_params = struct( ...
        'target_energy_kWh', E_bess_cap, ...
        'max_power_W', P_bess_max * 1000, ...
        'initial_soc', 0.5);

    [pack_info, state_bess] = bess_pack_model(0, 'init', init_params, 1/12, []);
    pars.E_cap_nom = pack_info.E_installed_kWh;

    fprintf('Szimuláció futtatása a %d. naptól a %d. napig...\n', START_DAY, FINAL_DAY);

    current_month_peak = 0;
    P_12month_max = 0; % Teszthez most nincs ratchet

    nSimDays = FINAL_DAY - START_DAY + 1;

    daily_peak_no_bess      = zeros(1, nSimDays);
    daily_peak_with_bess    = zeros(1, nSimDays);
    daily_energy_cost       = zeros(1, nSimDays);
    daily_deg_cost          = zeros(1, nSimDays);
    daily_overrun_cost      = zeros(1, nSimDays);
    daily_total_cost        = zeros(1, nSimDays);
    daily_peak_over_ref     = zeros(1, nSimDays);
    daily_bess_throughput   = zeros(1, nSimDays);
    daily_planned_peak      = zeros(1, nSimDays);
    daily_ref_contract      = zeros(1, nSimDays);

    for d = START_DAY:FINAL_DAY

        if isfield(pars, 'deg_cost_huf_kwh')
            pars.degradation_cost_per_kWh = pars.deg_cost_huf_kwh;
        end

        current_day_of_month = mod(d-1, 30) + 1;
        dt_h = PV_A(d).dt_h;

        % Tényleges napi profilok
        P_pv_dc_actual = (PV_A(d).Ppv + PV_B(d).Ppv) / 1000; % [kW]
        P_load_actual  = Load(d).P_load_kW;                  % [kW]
        Prices_today   = Price(d);

        % Előrejelzések (teszt setup szerint)
        idx_f_today = d - 7;
        % P_load_f_today = Load(idx_f_today).P_load_kW;
        P_load_f_today = Load(d).P_load_kW;
        P_pv_f_today   = (PV_A(d).Ppv + PV_B(d).Ppv) / 1000;

        idx_f_tomorrow = d - 6;
        % P_load_f_tomorrow = Load(idx_f_tomorrow).P_load_kW;
        P_load_f_tomorrow = Load(d+1).P_load_kW;
        P_pv_f_tomorrow   = (PV_A(d+1).Ppv + PV_B(d+1).Ppv) / 1000;
        Prices_tomorrow   = Price(d+1);

        % Összefűzés 48 órára
        P_load_48h = [P_load_f_today, P_load_f_tomorrow];
        P_pv_48h   = [P_pv_f_today,   P_pv_f_tomorrow];
        Prices_48h.buy_huf = [Prices_today.buy_huf, Prices_tomorrow.buy_huf];

        if d == FINAL_DAY
            soc_start_of_final_day = state_bess.cell_state.SOC;
        end

        tariff = create_hungarian_mv_tariff_structure();

        % ===== REFERENCIA LEKÖTÖTT TELJESÍTMÉNY =====
        tariff.contracted_capacity_kW = 750;

        % Ha erősebb peak shavinget akarsz, ezeket növeld:
        % tariff.penalty_rate_huf_per_kW_year = 4.0 * tariff.annual_contracted_power_fee_huf_per_kW;
        % tariff.peak_shadow_weight = 0.08;

        plan_full = ems_day_ahead_planner_milp_enhanced( ...
            P_load_48h, ...
            P_pv_48h, ...
            Prices_48h, ...
            pars, ...
            tariff, ...
            dt_h, ...
            current_day_of_month, ...
            P_12month_max);

        % Csak az első nap kivágása a 48 órás tervből
        nDay = length(P_load_actual);

        plan_today = plan_full;
        plan_today.trade_buy_mask  = plan_full.trade_buy_mask(1:nDay);
        plan_today.trade_sell_mask = plan_full.trade_sell_mask(1:nDay);
        plan_today.P_ch_plan       = plan_full.P_ch_plan(1:nDay);
        plan_today.P_dis_plan      = plan_full.P_dis_plan(1:nDay);
        plan_today.P_grid_plan     = plan_full.P_grid_plan(1:nDay);
        plan_today.P_curt_plan     = plan_full.P_curt_plan(1:nDay);
        plan_today.SoC_plan        = plan_full.SoC_plan(1:nDay);

        % Valós idejű végrehajtó
        P_bess_dc_req_kW = ems_realtime_decision_dc( ...
            P_pv_dc_actual, P_load_actual, plan_today, pars);

        [dayRes, state_bess] = topology_dc_coupled( ...
            P_bess_dc_req_kW, P_pv_dc_actual, P_load_actual, ...
            Prices_today, pars, state_bess, dt_h);

        % Memória frissítése
        actual_daily_peak = max(dayRes.E_grid_import) / dt_h;
        if actual_daily_peak > current_month_peak
            current_month_peak = actual_daily_peak;
        end

        ii = d - START_DAY + 1;

        % BESS nélküli referencia import
        P_grid_no_bess_day   = max(P_load_actual - P_pv_dc_actual * pars.inv_eta, 0);

        % BESS-sel tényleges hálózati import
        P_grid_with_bess_day = dayRes.E_grid_import / dt_h;

        daily_peak_no_bess(ii)   = max(P_grid_no_bess_day);
        daily_peak_with_bess(ii) = max(P_grid_with_bess_day);
        daily_peak_over_ref(ii)  = max(0, daily_peak_with_bess(ii) - plan_today.P_limit_ref);

        daily_energy_cost(ii)    = plan_today.economics.energy_cost_total;
        daily_deg_cost(ii)       = plan_today.economics.degradation_cost;
        daily_overrun_cost(ii)   = plan_today.economics.overrun_cost_proxy;
        daily_total_cost(ii)     = plan_today.economics.energy_cost_total + ...
                                   plan_today.economics.degradation_cost + ...
                                   plan_today.economics.overrun_cost_proxy + ...
                                   plan_today.economics.peak_shadow_cost;

        daily_bess_throughput(ii) = sum(dayRes.E_stored + dayRes.E_discharged);
        daily_planned_peak(ii)    = plan_today.P_limit;
        daily_ref_contract(ii)    = plan_today.P_limit_ref;

        % Utolsó nap mentése plothoz
        if d == FINAL_DAY
            plot_plan  = plan_today;
            plot_res   = dayRes;
            plot_load  = P_load_actual;
            plot_pv    = P_pv_dc_actual;
            plot_price = Prices_today;
        end
    end

    % =========================================================================
    % VIZUALIZÁCIÓ - NAPI RÉSZLET
    % =========================================================================
    time_hours = linspace(0, 24, length(plot_load));

    figure('Name', sprintf('EMS Teszt - %d. Nap', FINAL_DAY), ...
           'Position', [100, 100, 1250, 950]);

    % --- 1. Subplot: teljesítményáramlások ---
    subplot(3,1,1); hold on; grid on;
    title('Teljesítményáramlások és tervezett hálózati limit', 'FontSize', 12);

    P_pv_ac = plot_pv * pars.inv_eta;
    P_pv_to_load = min(P_pv_ac, plot_load);

    residual_after_pv = max(plot_load - P_pv_to_load, 0);
    P_bess_to_load = min(plot_res.E_discharged / dt_h, residual_after_pv);
    P_grid_to_load = max(plot_load - P_pv_to_load - P_bess_to_load, 0);

    P_bess_charge = plot_res.E_stored / dt_h;
    P_load_line   = plot_load;

    h = area(time_hours, [P_pv_to_load', P_bess_to_load', P_grid_to_load']);
    h(1).FaceColor = [0.4660 0.6740 0.1880]; h(1).DisplayName = 'PV -> fogyasztás';
    h(2).FaceColor = [0.0000 0.4470 0.7410]; h(2).DisplayName = 'BESS -> fogyasztás';
    h(3).FaceColor = [0.6350 0.0780 0.1840]; h(3).DisplayName = 'Grid -> fogyasztás';

    plot(time_hours, P_bess_charge, 'Color', [0.9290 0.6940 0.1250], ...
        'LineWidth', 2, 'DisplayName', 'BESS töltés');
    plot(time_hours, P_load_line, 'k-', 'LineWidth', 1.2, 'DisplayName', 'Összes fogyasztás');

    yline(plot_plan.P_limit, 'k--', 'LineWidth', 2, 'DisplayName', 'Tervezett peak limit');
    yline(plot_plan.P_limit_ref, 'r:', 'LineWidth', 1.5, 'DisplayName', 'Referencia contract');

    ylabel('Teljesítmény [kW]');
    legend('Location', 'northeastoutside');

    % --- 2. Subplot: ár és töltési/kisütési terv ---
    subplot(3,1,2); hold on; grid on;
    title('Vételi ár és töltési/kisütési terv', 'FontSize', 12);

    plot(time_hours, plot_price.buy_huf, 'k', 'LineWidth', 1.5, ...
        'DisplayName', 'Vételi ár (HUF/kWh)');

    buy_idx = find(plot_plan.trade_buy_mask);
    if ~isempty(buy_idx)
        plot(time_hours(buy_idx), plot_price.buy_huf(buy_idx), 'g.', ...
            'MarkerSize', 15, 'DisplayName', 'Tervezett töltési ablak');
    end

    sell_idx = find(plot_plan.trade_sell_mask);
    if ~isempty(sell_idx)
        plot(time_hours(sell_idx), plot_price.buy_huf(sell_idx), 'r.', ...
            'MarkerSize', 15, 'DisplayName', 'Tervezett kisütési ablak');
    end

    ylabel('Ár [HUF/kWh]');
    legend('Location', 'northwest');
    xlim([0 24]);

    % --- 3. Subplot: SOC és BESS teljesítmény ---
    subplot(3,1,3); yyaxis left; hold on; grid on;

    E_net_kWh = plot_res.E_stored - plot_res.E_discharged;
    SOC_approx = soc_start_of_final_day + cumsum(E_net_kWh) / pars.E_cap_nom;

    plot(time_hours, SOC_approx * 100, 'b', 'LineWidth', 2, 'DisplayName', 'SOC (%)');
    ylabel('Töltöttség (SOC) [%]');
    ylim([0 100]);
    yline(pars.SoC_min*100, 'r:', 'LineWidth', 1.5);
    yline(pars.SoC_max*100, 'r:', 'LineWidth', 1.5);

    yyaxis right;
    bar(time_hours, plot_res.E_bess_dc / dt_h, ...
        'FaceColor', [0.3010 0.7450 0.9330], ...
        'EdgeColor', 'none', 'BarWidth', 1, ...
        'DisplayName', 'BESS DC teljesítmény');

    ylabel('BESS teljesítmény [kW]');
    legend('Location', 'northeast');
    xlim([0 24]);
    xlabel('Idő [óra]');

    % =========================================================================
    % NUMERIKUS KIÉRTÉKELÉS
    % =========================================================================
    fprintf('=== TESZT BEFEJEZVE ===\n');

    P_grid_no_bess = max(plot_load - plot_pv * pars.inv_eta, 0);
    P_grid_with_bess = plot_res.E_grid_import / dt_h;

    peak_no_bess   = max(P_grid_no_bess);
    peak_with_bess = max(P_grid_with_bess);
    peak_reduction = peak_no_bess - peak_with_bess;
    peak_over_ref  = max(0, peak_with_bess - plot_plan.P_limit_ref);

    fprintf('\n=== NAPI KIÉRTÉKELÉS ===\n');
    fprintf('BESS nelkuli peak import:          %.2f kW\n', peak_no_bess);
    fprintf('BESS-es peak import:               %.2f kW\n', peak_with_bess);
    fprintf('Peak csokkenes (negativ is lehet): %.2f kW\n', peak_reduction);
    fprintf('Tervezett peak limit:              %.2f kW\n', plot_plan.P_limit);
    fprintf('Referencia contract limit:         %.2f kW\n', plot_plan.P_limit_ref);
    fprintf('Teny. tullepes a ref limit felett: %.2f kW\n', peak_over_ref);

    fprintf('Napi energia koltseg (market):     %.2f HUF\n', plot_plan.economics.energy_cost_market);
    fprintf('Napi halozati energiadij:          %.2f HUF\n', plot_plan.economics.energy_cost_network);
    fprintf('Napi degradacios koltseg:          %.2f HUF\n', plot_plan.economics.degradation_cost);
    fprintf('Napi overrun proxy koltseg:        %.2f HUF\n', plot_plan.economics.overrun_cost_proxy);
    fprintf('Napi peak shadow koltseg:          %.2f HUF\n', plot_plan.economics.peak_shadow_cost);
    fprintf('Napi operativ netto koltseg:       %.2f HUF\n', plot_plan.economics.net_cost_operational);

    if peak_with_bess > peak_no_bess
        fprintf('\nMEGJEGYZES:\n');
        fprintf(['A BESS-es napi peak most nagyobb lett, mint a BESS nelkuli referencia.\n' ...
                 'Ez nem feltetlen hiba: a vezerles olcso orakban halozatrol is tolthet,\n' ...
                 'ezert a halozati import atmenetileg megemelkedhet.\n' ...
                 'Ha erosebb peak shavinget akarsz, novelni kell a penalty_rate vagy a peak_shadow_weight erteket.\n']);
    end

    % =========================================================================
    % TERV VS TENYLEGES IMPORT
    % =========================================================================
    figure('Name', 'MILP terv vs tényleges hálózati import', 'Position', [150, 150, 1000, 400]);
    hold on; grid on;

    P_grid_actual  = plot_res.E_grid_import / dt_h;
    P_grid_planned = plot_plan.P_grid_plan(:)';

    plot(time_hours, P_grid_planned, 'b--', 'LineWidth', 2, 'DisplayName', 'Tervezett P_{grid}');
    plot(time_hours, P_grid_actual,  'r-',  'LineWidth', 1.5, 'DisplayName', 'Tényleges P_{grid}');
    yline(plot_plan.P_limit_ref, 'k:', 'LineWidth', 1.5, 'DisplayName', 'Ref. contract');
    yline(plot_plan.P_limit, 'g--', 'LineWidth', 1.5, 'DisplayName', 'Tervezett peak');

    xlabel('Idő [óra]');
    ylabel('Teljesítmény [kW]');
    title('Tervezett és tényleges hálózati import összehasonlítása');
    legend('Location', 'best');

    % =========================================================================
    % TERV VS TENYLEGES BESS
    % =========================================================================
    figure('Name', 'MILP BESS terv vs tényleges végrehajtás', 'Position', [180, 180, 1000, 400]);
    hold on; grid on;

    P_bess_plan   = plot_plan.P_dis_plan(:)' - plot_plan.P_ch_plan(:)';
    P_bess_actual = plot_res.E_bess_dc / dt_h;

    plot(time_hours, P_bess_plan,   'b--', 'LineWidth', 2, 'DisplayName', 'Tervezett BESS teljesítmény');
    plot(time_hours, P_bess_actual, 'r-',  'LineWidth', 1.5, 'DisplayName', 'Tényleges BESS DC teljesítmény');

    yline(0, 'k:');
    xlabel('Idő [óra]');
    ylabel('Teljesítmény [kW]');
    title('Tervezett és tényleges BESS teljesítmény');
    legend('Location', 'best');

    % =========================================================================
    % HOSSZABB IDOTAVU OSSZESITO
    % =========================================================================
    days_axis = START_DAY:FINAL_DAY;

    figure('Name', 'Hosszabb távú EMS összesítő', 'Position', [200, 120, 1300, 950]);

    subplot(4,1,1); hold on; grid on;
    plot(days_axis, daily_peak_no_bess,   'k--', 'LineWidth', 1.5, 'DisplayName', 'Peak BESS nélkül');
    plot(days_axis, daily_peak_with_bess, 'b-',  'LineWidth', 1.8, 'DisplayName', 'Peak BESS-sel');
    plot(days_axis, daily_planned_peak,   'm-',  'LineWidth', 1.6, 'DisplayName', 'MILP tervezett P_{peak}');
    yline(750, 'r:', 'LineWidth', 1.5, 'DisplayName', 'Referencia contract = 750 kW');
    ylabel('Peak [kW]');
    title('Napi peak import és MILP tervezett peak');
    legend('Location', 'best');

    subplot(4,1,2); hold on; grid on;
    plot(days_axis, daily_energy_cost,  'k-', 'LineWidth', 1.5, 'DisplayName', 'Energia költség');
    plot(days_axis, daily_deg_cost,     'b-', 'LineWidth', 1.5, 'DisplayName', 'Degradáció');
    plot(days_axis, daily_overrun_cost, 'r-', 'LineWidth', 1.5, 'DisplayName', 'Overrun proxy');
    plot(days_axis, daily_total_cost,   'm-', 'LineWidth', 2,   'DisplayName', 'Összes napi költség');
    ylabel('Költség [HUF]');
    title('Napi költségösszetevők');
    legend('Location', 'best');

    subplot(4,1,3); hold on; grid on;
    bar(days_axis, daily_bess_throughput, 'FaceColor', [0.2 0.6 0.8], 'DisplayName', 'Napi BESS throughput');
    ylabel('Energia [kWh]');
    title('Napi BESS igénybevétel');

    subplot(4,1,4); hold on; grid on;
    plot(days_axis, daily_planned_peak, 'm-', 'LineWidth', 2, 'DisplayName', 'MILP napi optimális P');
    plot(days_axis, daily_ref_contract, 'r--', 'LineWidth', 1.5, 'DisplayName', 'Fix referencia contract');
    plot(days_axis, daily_peak_with_bess, 'b:', 'LineWidth', 1.5, 'DisplayName', 'Tényleges napi peak');
    ylabel('Teljesítmény [kW]');
    xlabel('Nap index');
    title('Az algoritmus napi optimális P-je és a referencia contract');
    legend('Location', 'best');
end


function pars = base_battery_pars_nonideal_(E_cap_nom, Pmax)
% Alap BESS paraméterek – kalibráció belső defaultokon.
    pars = struct();

    % --- Névl. méretek és teljesítménykorlátok ---
    pars.E_cap_nom        = E_cap_nom;            
    pars.P_rated          = Pmax;              
    pars.C_chg_abs_max    = Pmax / max(E_cap_nom, eps);
    pars.C_dis_abs_max    = pars.C_chg_abs_max;
    pars.P_chg_max        = Pmax;
    pars.P_dis_max        = Pmax;

    % --- SoC határok és kezdeti állapot ---
    pars.SoC_min          = 0.20;
    pars.SoC_max          = 0.80;
    pars.SoC_init         = 0.50;

    % --- Konverter ág hatásfokok és ohmikus alapbüntetés ---
    pars.eta_c            = 0.975;
    pars.eta_d            = 0.975;
    pars.k_ohm            = 0.020;

    % --- Önkisülés ---
    pars.self_dis_per_h   = 2e-5;

    % --- Kapacitás alsó korlát ---
    pars.cap_floor_frac   = 0.70;

    % --- Inverter és DC/DC hatásfokok ---
    pars.inv_eta          = 0.97;
    pars.eta_c       = 0.98;
    pars.eta_d       = 0.98;

    % ===== Cella szintű kiegészítések =====
    pars.eta_cell         = 0.985;
    pars.eta_cell_min     = 0.90;

    % Pillanatnyi C-ráta és SoC büntetés a cellahatásfokra
    pars.k_eta_C2         = 0.02;
    pars.k_eta_soc        = 0.02;
    pars.soc_ref          = 0.5;

    % Impedancia-növekedés skálái
    pars.R_growth_time_k  = 0.50;
    pars.R_growth_cap_k   = 1.00;

    % Ajánlott C-ráta (belső referencia)
    C_abs                 = Pmax / max(E_cap_nom, eps);
    C_ref                 = min(C_abs, 0.5);
    pars.C_rec_chg        = C_ref;
    pars.C_rec_dis        = C_ref;
end

function P_bess_dc_req = ems_realtime_decision_dc(P_pv_dc, P_load_actual, plan, pars)
% EMS_REALTIME_DECISION_DC
% Az új MILP tervből képez végrehajtható BESS DC teljesítményparancsot.
%
% Elv:
% - P_ch_plan  > 0  -> töltési igény
% - P_dis_plan > 0  -> kisütési igény
%
% Kimenet:
%   P_bess_dc_req [kW]
%   pozitív  -> BESS kisütés (a DC sín felé)
%   negatív  -> BESS töltés

    N = length(P_pv_dc);

    P_bess_dc_req = zeros(1, N);

    % Biztonsági ellenőrzés
    if ~isfield(plan, 'P_ch_plan') || ~isfield(plan, 'P_dis_plan')
        % Fallback: ha valamiért nincs explicit terv,
        % használd a maszkos logikát egyszerűsítve
        P_bess_dc_req(plan.trade_buy_mask)  = -pars.P_chg_max * pars.inv_eta;
        P_bess_dc_req(plan.trade_sell_mask) =  pars.P_dis_max / max(pars.inv_eta, eps);
        return;
    end

    P_ch_ac  = plan.P_ch_plan(:).';
    P_dis_ac = plan.P_dis_plan(:).';

    % AC oldali tervek -> DC oldali BESS kérés
    %
    % Kisütés:
    %   AC oldalon P_dis_ac leadásához a DC oldalon kb. P_dis_ac / eta_inv kell
    %
    % Töltés:
    %   AC oldalon P_ch_ac felvételhez a BESS DC oldalon kb. P_ch_ac * eta_inv töltést lát
    %
    % Pozitív: discharge
    % Negatív: charge
    P_bess_dc_req = (P_dis_ac ./ max(pars.inv_eta, eps)) - (P_ch_ac .* pars.inv_eta);

    % Fizikai teljesítménykorlátok
    P_bess_dc_req = min(P_bess_dc_req,  pars.P_dis_max);
    P_bess_dc_req = max(P_bess_dc_req, -pars.P_chg_max);

    % Ha nagyon kicsi numerikus zaj van, nullázzuk
    P_bess_dc_req(abs(P_bess_dc_req) < 1e-6) = 0;
end