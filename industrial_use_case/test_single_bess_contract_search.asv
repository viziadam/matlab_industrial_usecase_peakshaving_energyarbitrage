% function test_single_bess_contract_search()
% % TEST_SINGLE_BESS_CONTRACT_SEARCH
% % Egyetlen BESS méretre:
% % - peak-oriented, rule-assisted rolling MILP vezérlés
% % - contract sweep (durva + finom keresés)
% % - futásidő és optimum kiértékelés
% %
% % Külső függőségek, amelyeknek létezniük kell:
% %   build_pv_cache
% %   build_load_price_cache
% %   bess_pack_model
% %   topology_dc_coupled
% 
%     clc; close all;
%     fprintf('=== PEAK-ORIENTED BESS + CONTRACT SWEEP TESZT ===\n');
% 
%     % ---------------------------------------------------------------------
%     % 1) ADATOK
%     % ---------------------------------------------------------------------
%     fprintf('Adatok betöltése...\n');
%     PV_A = build_pv_cache(11, [95, 275], [274, 274], 0.325);
%     PV_B = build_pv_cache(11, [70, 250], [100.5, 100.5], 0.325);
%     [Load, Price] = build_load_price_cache();
% 
%     FINAL_DAY = 260;
%     START_DAY = FINAL_DAY - 129;   % 130 napos teszt
%     nSimDays = FINAL_DAY - START_DAY + 1;
% 
%     % ---------------------------------------------------------------------
%     % 2) BESS PARAMETEREK (1 db BESS méret)
%     % ---------------------------------------------------------------------
%     E_bess_cap = 1500; % [kWh]
%     P_bess_max = 750;  % [kW]
% 
%     pars = base_battery_pars_nonideal_(E_bess_cap, P_bess_max);
%     pars.P_inv_limit_ac = 550;
%     pars.degradation_cost_per_kWh = 5.0;
% 
%     fprintf('BESS paraméterek: E=%.1f kWh, P=%.1f kW\n', E_bess_cap, P_bess_max);
% 
%     % ---------------------------------------------------------------------
%     % 3) CONTRACT KERESÉS - DURVA + FINOM RÁCS
%     % ---------------------------------------------------------------------
%     coarse_candidates = 250:50:650;
% 
%     fprintf('\n--- DURVA CONTRACT KERESÉS ---\n');
%     t_coarse = tic;
%     coarse_results = local_run_contract_sweep( ...
%         coarse_candidates, START_DAY, FINAL_DAY, ...
%         PV_A, PV_B, Load, Price, pars, false);
%     coarse_runtime = toc(t_coarse);
% 
%     [~, idx_best_coarse] = min([coarse_results.total_cost_period_huf]);
%     best_coarse_contract = coarse_results(idx_best_coarse).contract_kW;
% 
%     fprintf('Durva optimum: %.1f kW\n', best_coarse_contract);
% 
%     fine_candidates = unique(max(25, best_coarse_contract-50):10:(best_coarse_contract+50));
% 
%     fprintf('\n--- FINOM CONTRACT KERESÉS ---\n');
%     t_fine = tic;
%     fine_results = local_run_contract_sweep( ...
%         fine_candidates, START_DAY, FINAL_DAY, ...
%         PV_A, PV_B, Load, Price, pars, false);
%     fine_runtime = toc(t_fine);
% 
%     [~, idx_best_fine] = min([fine_results.total_cost_period_huf]);
%     best_contract = fine_results(idx_best_fine).contract_kW;
% 
%     fprintf('Finom optimum: %.1f kW\n', best_contract);
% 
%     % ---------------------------------------------------------------------
%     % 4) RÉSZLETES FUTÁS A LEGJOBB CONTRACTRA
%     % ---------------------------------------------------------------------
%     fprintf('\n--- RESZLETES FUTAS A LEGJOBB CONTRACTRA (%.1f kW) ---\n', best_contract);
%     t_best = tic;
%     best_detail = local_run_single_contract( ...
%         best_contract, START_DAY, FINAL_DAY, ...
%         PV_A, PV_B, Load, Price, pars, true);
%     best_runtime = toc(t_best);
% 
%     total_runtime = coarse_runtime + fine_runtime + best_runtime;
% 
%     % ---------------------------------------------------------------------
%     % 5) LOGOK
%     % ---------------------------------------------------------------------
%     fprintf('\n================ ÖSSZEFOGLALÓ ================\n');
%     fprintf('Tesztelt BESS méret:                  E=%.1f kWh, P=%.1f kW\n', E_bess_cap, P_bess_max);
%     fprintf('Szimulált napok száma:                %d nap\n', nSimDays);
%     fprintf('Durva sweep futásidő:                 %.2f s\n', coarse_runtime);
%     fprintf('Finom sweep futásidő:                 %.2f s\n', fine_runtime);
%     fprintf('Legjobb contract részletes futás:     %.2f s\n', best_runtime);
%     fprintf('Teljes script futásidő:               %.2f s\n', total_runtime);
% 
%     fprintf('\nOptimális lekötött teljesítmény:      %.1f kW\n', best_detail.contract_kW);
%     fprintf('Időszakos contract költség:           %.2f HUF\n', best_detail.contract_cost_period_huf);
%     fprintf('Időszakos energia költség:            %.2f HUF\n', best_detail.energy_cost_period_huf);
%     fprintf('Időszakos degradációs költség:        %.2f HUF\n', best_detail.degradation_cost_period_huf);
%     fprintf('Időszakos overrun proxy költség:      %.2f HUF\n', best_detail.overrun_cost_period_huf);
%     fprintf('Időszakos peak shadow költség:        %.2f HUF\n', best_detail.peak_shadow_cost_period_huf);
%     fprintf('Időszakos teljes költség:             %.2f HUF\n', best_detail.total_cost_period_huf);
% 
%     fprintf('\nPeak statisztikák:\n');
%     fprintf('No-BESS max peak:                     %.2f kW\n', max(best_detail.daily_peak_no_bess));
%     fprintf('BESS max peak:                        %.2f kW\n', max(best_detail.daily_peak_with_bess));
%     fprintf('MILP átlagos tervezett peak:          %.2f kW\n', mean(best_detail.daily_planned_peak));
%     fprintf('Átlagos napi BESS throughput:         %.2f kWh/nap\n', mean(best_detail.daily_bess_throughput));
%     fprintf('Túllépéses napok száma:               %d / %d\n', ...
%         sum(best_detail.daily_peak_with_bess > best_detail.daily_ref_contract + 1e-6), nSimDays);
% 
%     % ---------------------------------------------------------------------
%     % 6) PLOTOK
%     % ---------------------------------------------------------------------
%     local_plot_contract_sweep(coarse_results, fine_results, best_detail);
%     local_plot_best_day(best_detail);
%     local_plot_best_period(best_detail);
% 
%     fprintf('\n=== KÉSZ ===\n');
% end
% 
% % =========================================================================
% % CONTRACT SWEEP
% % =========================================================================
% function results = local_run_contract_sweep(contract_candidates, START_DAY, FINAL_DAY, ...
%     PV_A, PV_B, Load, Price, pars, store_detail)
% 
%     nC = numel(contract_candidates);
%     results = [];
% 
%     for i = 1:nC
%         contract_kW = contract_candidates(i);
%         fprintf('Contract sweep: %.1f kW ...\n', contract_kW);
% 
%         t_one = tic;
%         res_i = local_run_single_contract( ...
%             contract_kW, START_DAY, FINAL_DAY, ...
%             PV_A, PV_B, Load, Price, pars, store_detail);
%         res_i.runtime_s = toc(t_one);
% 
%         if i == 1
%             results = repmat(res_i, 1, nC);
%         end
% 
%         results(i) = res_i;
% 
%         fprintf('  total cost = %.2f HUF | runtime = %.2f s\n', ...
%             res_i.total_cost_period_huf, res_i.runtime_s);
%     end
% end
% 
% % =========================================================================
% % EGY CONTRACT RÉSZLETES / AGGREGÁLT FUTTATÁSA
% % =========================================================================
% function result = local_run_single_contract(contract_kW, START_DAY, FINAL_DAY, ...
%     PV_A, PV_B, Load, Price, pars_in, store_detail)
% 
%     nSimDays = FINAL_DAY - START_DAY + 1;
%     days_in_year = 365;
% 
%     pars = pars_in;
% 
%     % Akku inicializálása
%     init_params = struct( ...
%         'target_energy_kWh', pars.E_cap_nom, ...
%         'max_power_W', pars.P_rated * 1000, ...
%         'initial_soc', 0.5);
% 
%     [pack_info, state_bess] = bess_pack_model(0, 'init', init_params, 1/12, []);
%     pars.E_cap_nom = pack_info.E_installed_kWh;
% 
%     P_12month_max = 0;
%     current_month_peak = 0;
% 
%     % Napi gyűjtők
%     daily_peak_no_bess    = zeros(1, nSimDays);
%     daily_peak_with_bess  = zeros(1, nSimDays);
%     daily_energy_cost     = zeros(1, nSimDays);
%     daily_deg_cost        = zeros(1, nSimDays);
%     daily_overrun_cost    = zeros(1, nSimDays);
%     daily_peak_shadow     = zeros(1, nSimDays);
%     daily_total_cost      = zeros(1, nSimDays);
%     daily_bess_throughput = zeros(1, nSimDays);
%     daily_planned_peak    = zeros(1, nSimDays);
%     daily_ref_contract    = zeros(1, nSimDays);
% 
%     % Részletes végső napi tárolók
%     plot_plan = [];
%     plot_res = [];
%     plot_load = [];
%     plot_pv = [];
%     plot_price = [];
%     soc_start_of_final_day = NaN;
% 
%     for d = START_DAY:FINAL_DAY
% 
%         current_day_of_month = mod(d-1, 30) + 1;
%         dt_h = PV_A(d).dt_h;
% 
%         % Tényleges napi profilok
%         P_pv_dc_actual = (PV_A(d).Ppv + PV_B(d).Ppv) / 1000;
%         P_load_actual  = Load(d).P_load_kW;
%         Prices_today   = Price(d);
% 
%         % Tökéletes forecast a validációhoz
%         P_load_f_today = Load(d).P_load_kW;
%         P_pv_f_today   = (PV_A(d).Ppv + PV_B(d).Ppv) / 1000;
% 
%         P_load_f_tomorrow = Load(d+1).P_load_kW;
%         P_pv_f_tomorrow   = (PV_A(d+1).Ppv + PV_B(d+1).Ppv) / 1000;
%         Prices_tomorrow   = Price(d+1);
% 
%         P_load_48h = [P_load_f_today, P_load_f_tomorrow];
%         P_pv_48h   = [P_pv_f_today,   P_pv_f_tomorrow];
% 
%         Prices_48h.buy_huf = [Prices_today.buy_huf, Prices_tomorrow.buy_huf];
% 
%         if d == FINAL_DAY
%             soc_start_of_final_day = state_bess.cell_state.SOC;
%         end
% 
%         tariff = create_hungarian_mv_tariff_structure_peak_oriented();
%         tariff.contracted_capacity_kW = contract_kW;
% 
%         plan_full = ems_day_ahead_planner_milp_peak_oriented( ...
%             P_load_48h, P_pv_48h, Prices_48h, pars, tariff, dt_h, ...
%             current_day_of_month, P_12month_max);
% 
%         nDay = length(P_load_actual);
% 
%         plan_today = plan_full;
%         plan_today.trade_buy_mask  = plan_full.trade_buy_mask(1:nDay);
%         plan_today.trade_sell_mask = plan_full.trade_sell_mask(1:nDay);
%         plan_today.P_ch_plan       = plan_full.P_ch_plan(1:nDay);
%         plan_today.P_dis_plan      = plan_full.P_dis_plan(1:nDay);
%         plan_today.P_grid_plan     = plan_full.P_grid_plan(1:nDay);
%         plan_today.P_curt_plan     = plan_full.P_curt_plan(1:nDay);
%         plan_today.SoC_plan        = plan_full.SoC_plan(1:nDay);
% 
%         % Realtime végrehajtás
%         P_bess_dc_req_kW = ems_realtime_decision_dc( ...
%             P_pv_dc_actual, P_load_actual, plan_today, pars);
% 
%         [dayRes, state_bess] = topology_dc_coupled( ...
%             P_bess_dc_req_kW, P_pv_dc_actual, P_load_actual, ...
%             Prices_today, pars, state_bess, dt_h);
% 
%         actual_daily_peak = max(dayRes.E_grid_import) / dt_h;
%         current_month_peak = max(current_month_peak, actual_daily_peak);
% 
%         ii = d - START_DAY + 1;
% 
%         P_grid_no_bess_day   = max(P_load_actual - P_pv_dc_actual * pars.inv_eta, 0);
%         P_grid_with_bess_day = dayRes.E_grid_import / dt_h;
% 
%         daily_peak_no_bess(ii)    = max(P_grid_no_bess_day);
%         daily_peak_with_bess(ii)  = max(P_grid_with_bess_day);
%         daily_energy_cost(ii)     = plan_today.economics.energy_cost_total;
%         daily_deg_cost(ii)        = plan_today.economics.degradation_cost;
%         daily_overrun_cost(ii)    = plan_today.economics.overrun_cost_proxy;
%         daily_peak_shadow(ii)     = plan_today.economics.peak_shadow_cost;
%         daily_total_cost(ii)      = plan_today.economics.energy_cost_total + ...
%                                     plan_today.economics.degradation_cost + ...
%                                     plan_today.economics.overrun_cost_proxy + ...
%                                     plan_today.economics.peak_shadow_cost;
%         daily_bess_throughput(ii) = sum(dayRes.E_stored + dayRes.E_discharged);
%         daily_planned_peak(ii)    = plan_today.P_limit;
%         daily_ref_contract(ii)    = plan_today.P_limit_ref;
% 
%         if store_detail && d == FINAL_DAY
%             plot_plan  = plan_today;
%             plot_res   = dayRes;
%             plot_load  = P_load_actual;
%             plot_pv    = P_pv_dc_actual;
%             plot_price = Prices_today;
%         end
%     end
% 
%     % Időszakos fix contract költség
%     period_days = nSimDays;
%     tariff = create_hungarian_mv_tariff_structure_peak_oriented();
%     contract_cost_period = (period_days / days_in_year) * ...
%         (tariff.annual_contracted_power_fee_huf_per_kW * contract_kW + tariff.annual_base_fee_huf);
% 
%     result = struct();
%     result.contract_kW = contract_kW;
% 
%     result.energy_cost_period_huf       = sum(daily_energy_cost);
%     result.degradation_cost_period_huf  = sum(daily_deg_cost);
%     result.overrun_cost_period_huf      = sum(daily_overrun_cost);
%     result.peak_shadow_cost_period_huf  = sum(daily_peak_shadow);
%     result.contract_cost_period_huf     = contract_cost_period;
% 
%     result.total_cost_period_huf = result.energy_cost_period_huf + ...
%                                    result.degradation_cost_period_huf + ...
%                                    result.overrun_cost_period_huf + ...
%                                    result.peak_shadow_cost_period_huf + ...
%                                    result.contract_cost_period_huf;
% 
%     result.daily_peak_no_bess      = daily_peak_no_bess;
%     result.daily_peak_with_bess    = daily_peak_with_bess;
%     result.daily_energy_cost       = daily_energy_cost;
%     result.daily_deg_cost          = daily_deg_cost;
%     result.daily_overrun_cost      = daily_overrun_cost;
%     result.daily_peak_shadow       = daily_peak_shadow;
%     result.daily_total_cost        = daily_total_cost;
%     result.daily_bess_throughput   = daily_bess_throughput;
%     result.daily_planned_peak      = daily_planned_peak;
%     result.daily_ref_contract      = daily_ref_contract;
%     result.days_axis               = START_DAY:FINAL_DAY;
% 
%     result.final_day = struct();
%     result.final_day.plan      = plot_plan;
%     result.final_day.res       = plot_res;
%     result.final_day.load      = plot_load;
%     result.final_day.pv        = plot_pv;
%     result.final_day.price     = plot_price;
%     result.final_day.soc_start = soc_start_of_final_day;
% end
% 
% % =========================================================================
% % PLOTOK
% % =========================================================================
% function local_plot_contract_sweep(coarse_results, fine_results, best_detail)
% 
%     all_results = [coarse_results, fine_results];
%     contracts_all = [all_results.contract_kW];
% 
%     % Rendezzük contract szerint
%     [contracts_all, idx_sort] = sort(contracts_all);
%     all_results = all_results(idx_sort);
% 
%     % Duplikált contractok kezelése:
%     % ugyanarra a contract értékre csak az utolsó előfordulást tartjuk meg
%     [contracts_unique, ia] = unique(contracts_all, 'last');
%     all_results = all_results(ia);
% 
%     contracts = contracts_unique(:).';
% 
%     total_cost    = [all_results.total_cost_period_huf];
%     contract_cost = [all_results.contract_cost_period_huf];
%     energy_cost   = [all_results.energy_cost_period_huf];
%     degr_cost     = [all_results.degradation_cost_period_huf];
%     over_cost     = [all_results.overrun_cost_period_huf];
%     runtime_s     = [all_results.runtime_s];
%     max_peak      = arrayfun(@(s) max(s.daily_peak_with_bess), all_results);
%     mean_peak     = arrayfun(@(s) mean(s.daily_peak_with_bess), all_results);
% 
%     figure('Name', 'Contract sweep eredmények', 'Position', [80, 80, 1350, 900]);
% 
%     subplot(2,2,1); hold on; grid on;
%     plot(contracts, total_cost, 'k-o', 'LineWidth', 2, 'DisplayName', 'Teljes költség');
%     xline(best_detail.contract_kW, 'r--', 'LineWidth', 1.5, ...
%         'DisplayName', sprintf('Optimális contract = %.0f kW', best_detail.contract_kW));
%     xlabel('Lekötött teljesítmény [kW]');
%     ylabel('Költség [HUF]');
%     title('Teljes költség a contract függvényében');
%     legend('Location', 'best');
% 
%     subplot(2,2,2); hold on; grid on;
%     plot(contracts, energy_cost,   'k-', 'LineWidth', 1.5, 'DisplayName', 'Energia');
%     plot(contracts, degr_cost,     'b-', 'LineWidth', 1.5, 'DisplayName', 'Degradáció');
%     plot(contracts, over_cost,     'r-', 'LineWidth', 1.5, 'DisplayName', 'Overrun');
%     plot(contracts, contract_cost, 'm-', 'LineWidth', 1.5, 'DisplayName', 'Contract fix díj');
%     xlabel('Lekötött teljesítmény [kW]');
%     ylabel('Költség [HUF]');
%     title('Költségkomponensek');
%     legend('Location', 'best');
% 
%     subplot(2,2,3); hold on; grid on;
%     plot(contracts, max_peak,  'b-o', 'LineWidth', 1.5, 'DisplayName', 'Max napi peak');
%     plot(contracts, mean_peak, 'k-s', 'LineWidth', 1.5, 'DisplayName', 'Átlagos napi peak');
%     xline(best_detail.contract_kW, 'r--', 'LineWidth', 1.5, 'DisplayName', 'Optimális contract');
%     xlabel('Lekötött teljesítmény [kW]');
%     ylabel('Peak [kW]');
%     title('Peak statisztikák');
%     legend('Location', 'best');
% 
%     subplot(2,2,4); hold on; grid on;
%     bar(contracts, runtime_s, 'FaceColor', [0.2 0.6 0.8]);
%     xlabel('Lekötött teljesítmény [kW]');
%     ylabel('Futásidő [s]');
%     title('Sweep futásidő contract pontonként');
% end
% function local_plot_best_day(best_detail)
% 
%     if isempty(best_detail.final_day.plan)
%         return;
%     end
% 
%     plot_plan  = best_detail.final_day.plan;
%     plot_res   = best_detail.final_day.res;
%     plot_load  = best_detail.final_day.load;
%     plot_pv    = best_detail.final_day.pv;
%     plot_price = best_detail.final_day.price;
%     soc_start_of_final_day = best_detail.final_day.soc_start;
% 
%     pars_local.inv_eta = 0.97; % csak a napi plothoz, ugyanaz mint a base pars-ban
%     % Megjegyzés: ha akarod, ezt át lehet adni külön is.
% 
%     time_hours = linspace(0, 24, length(plot_load));
% 
%     figure('Name', sprintf('Legjobb contract napi részlet (%.0f kW)', best_detail.contract_kW), ...
